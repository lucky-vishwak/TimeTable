# ----------------------------------------------------------------------------
# Copy this file to ".env.local" and fill in real values. NEVER commit .env.local
# ----------------------------------------------------------------------------

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/timetable
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/timetable
MONGODB_URI=mongodb://127.0.0.1:27017/timetable

# Base URL the notify script uses to read due reminders from the app API.
APP_BASE_URL=http://127.0.0.1:3000

# ----------------------------------------------------------------------------
# Reminders are delivered as native macOS notifications by scripts/notify.mjs
# (run it via cron). No extra config needed — see README.
# ----------------------------------------------------------------------------
