# ----------------------------------------------------------------------------
# Copy this file to ".env.local" and fill in real values. NEVER commit .env.local
# ----------------------------------------------------------------------------

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/timetable
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/timetable
MONGODB_URI=mongodb://127.0.0.1:27017/timetable

# ----------------------------------------------------------------------------
# SMS reminders via an Android SMS Gateway app running on YOUR phone.
# Recommended app: "SMS Gateway" / "SMSGateway" or "Termux + termux-sms-send".
# The app exposes an HTTP endpoint on your phone; the notify script POSTs to it,
# and your phone sends the SMS from your real SIM (FROM number below).
# ----------------------------------------------------------------------------

# Full URL of your phone's SMS gateway endpoint (reachable from this machine).
# Example (android-sms-gateway / capcom6): http://<phone-ip>:8080/message
SMS_GATEWAY_URL=

# Optional basic-auth or API key for the gateway (depends on the app you use)
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
SMS_GATEWAY_API_KEY=

# Your numbers
SMS_FROM=7989872556
SMS_TO=9390434621

# Set to "true" to actually send SMS. When false, the notify script only logs
# what it WOULD send (safe for testing).
SMS_ENABLED=false

# Base URL the notify script uses to read due reminders from the app API.
APP_BASE_URL=http://127.0.0.1:3000
